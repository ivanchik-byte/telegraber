# =================================================================
# ОБЯЗАТЕЛЬНЫЕ ПАРАМЕТРЫ
# =================================================================

# Токен бота-контроллера от @BotFather (https://t.me/BotFather)
BOT_TOKEN=

# Числовой Telegram ID владельца (узнать у @userinfobot)
OWNER_ID=


# =================================================================
# ОПЦИОНАЛЬНЫЕ ПАРАМЕТРЫ (уже настроены значения по умолчанию)
# =================================================================

# Ключи API с https://my.telegram.org (по умолчанию официальный Telegram Desktop)
TELEGRAM_API_ID=2040
TELEGRAM_API_HASH=b18441a1b366a10c4822d4f3521e4b24

# Начальный режим для файлов >50 МБ: direct (в ЛС) или channel (в канал)
# Можно в любой момент переключить прямо в боте через /settings
FALLBACK_DESTINATION=direct

# ID канала/группы для режима channel (например, -1001234567890)
# Можно привязать кнопкой в /settings
TARGET_CHAT_ID=
