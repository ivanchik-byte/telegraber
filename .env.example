# Telegram Bot Controller (от @BotFather)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Ваш Telegram User ID (можно узнать через @userinfobot)
OWNER_ID=123456789

# Telegram API credentials (с https://my.telegram.org)
# Если оставить пустыми, бот запросит их в чате при первом запуске
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Режим доставки скачанных файлов:
# direct  - файлы <50 МБ отправляет бот в диалог, >50 МБ отправляет юзербот в ЛС
# channel - все файлы отправляются в указанный канал или группу-хранилище
# disk    - файлы только сохраняются на диск сервера (папка downloads) без повторной отправки
DELIVERY_MODE=direct

# ID целевого канала или группы для режима channel (например, -1001234567890)
TARGET_CHAT_ID=

# Системные пути внутри контейнера
DOWNLOAD_DIR=/app/downloads
SESSIONS_DIR=/app/sessions
TDATA_DIR=/app/tdata_input
